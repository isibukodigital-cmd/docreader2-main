{$DOCQA_DOMAIN:localhost} {
    encode zstd gzip

    @upload {
        method POST
        path /v1/documents
    }
    @missing_upload_auth {
        not header Authorization *
    }
    handle @upload {
        handle @missing_upload_auth {
            respond "A Supabase Bearer access token is required" 401
        }
        reverse_proxy app:8000 {
            transport http {
                dial_timeout 5s
                response_header_timeout 60s
                read_timeout 60s
                write_timeout 60s
            }
        }
    }

    handle /metrics {
        respond "Not Found" 404
    }

    request_body {
        max_size 21MB
    }

    reverse_proxy app:8000 {
        transport http {
            dial_timeout 5s
            response_header_timeout 60s
            read_timeout 60s
            write_timeout 60s
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output stdout
        format json
    }
}
