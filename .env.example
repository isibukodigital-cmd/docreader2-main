SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace-with-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DOCQA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DOCQA_BACKEND=extractive
# Keep tenant branding on trusted hostnames; tenant_id is also checked after authentication.
DOCQA_TENANT_BRANDING_JSON='{"acme.example.com":{"tenant_id":"tenant-acme","name":"Acme","tagline":"ACME KNOWLEDGE","logo_url":"/branding/acme-logo.svg","primary_color":"#164e63","accent_color":"#f0f9ff","login_heading":"Welcome to Acme","login_subtitle":"Ask questions across your approved company documents.","footer_text":"Answers are AI-generated; verify important information in source documents.","support_url":"mailto:support@acme.example.com","hide_attribution":true}}'
DOCQA_BRANDING_DIR=pics
# For Ollama:
# DOCQA_BACKEND=ollama
# DOCQA_MODEL=qwen2.5:3b

# --- Hosted language model (DOCQA_BACKEND=llm): randomized starting provider + fallback ---
# NOTE: questions + retrieved passages are sent to these providers. Disclose to customers.
# DOCQA_BACKEND=llm
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=your-verified-cerebras-model-id
# NVIDIA_NIM_API_KEY=
# NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
# Per-customer answer profiles: set "profile":"acme" in the branding entry, files in this dir
# DOCQA_PROFILES_DIR=profiles
# DOCQA_AUDIT_QUESTIONS=hash   # full | hash | none (default: hash)
# DOCQA_QUERY_RATE_PER_MINUTE=30
# DOCQA_UPLOAD_RATE_PER_MINUTE=10
# DOCQA_MAX_CONCURRENT_INGESTS=2

# Deployment architecture (Supabase or Cognito Auth; Supabase or PostgreSQL store)
# shared-hosted | dedicated-customer | local-preview
DOCQA_DEPLOYMENT_MODEL=shared-hosted
DOCQA_AUTH_PROVIDER=supabase
DOCQA_DOCUMENT_STORE=supabase
# For Amazon Cognito Hosted UI, set DOCQA_AUTH_PROVIDER=cognito and configure:
# DOCQA_COGNITO_REGION=eu-north-1
# DOCQA_COGNITO_USER_POOL_ID=eu-north-1_example
# DOCQA_COGNITO_CLIENT_ID=public-user-pool-app-client
# DOCQA_COGNITO_DOMAIN=https://your-domain.auth.eu-north-1.amazoncognito.com
# Microsoft Graph uses a separate Entra public-client app with delegated Graph permissions:
# DOCQA_MICROSOFT_GRAPH_CLIENT_ID=your-entra-application-client-id
# For a direct PostgreSQL store, set DOCQA_DOCUMENT_STORE=postgres and provide
# DOCQA_DATABASE_URL. For a fresh PostgreSQL database, initialize it with
# scripts/setup_database.py --provider postgres before starting the API.
# DOCQA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
